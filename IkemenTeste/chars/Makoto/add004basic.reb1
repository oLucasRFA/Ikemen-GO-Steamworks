;***************************************************************************;
;******************************* Common State ******************************;
;***************************************************************************;
;***************************************************************************;

;----------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 999,0]
type = destroyself
trigger1 = ishelper

[State 0, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno = 20 && Anim != 25
value = 25

[State 0, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = anim = 5300 && Anim != 5301
value = 5301

[State 210, 1]
type = PlaySnd
trigger1 = Anim = 5301
trigger1 = animelem = 14
value = 5300,1

[State 210, 1]
type = PlaySnd
triggerall = anim = 1005
trigger1 = animelem = 7
value = 20,0

[State 210, 1]
type = PlaySnd
triggerall = anim = 800 || anim = 830
trigger1 = animelem = 9
value = 20,0

[State 210, 1]
type = PlaySnd
triggerall = anim = 5301
trigger1 = animelem = 15
value = 20,0

[State 210, 1]
type = PlaySnd
triggerall = anim = 730
trigger1 = animelem = 17
value = 20,0

[State 210, 1]
type = PlaySnd
triggerall = anim = 3170
trigger1 = animelem = 10
value = 20,0

[State 19, Gi Flop]
type = PlaySnd
triggerall = anim = 1005
trigger1 = animelem = 7
value = s20,1

[State 19, Gi Flop]
type = PlaySnd
triggerall = anim = 800 || anim = 830
trigger1 = animelem = 9
value = s20,1

[State 19, Gi Flop]
type = PlaySnd
triggerall = anim = 5301
trigger1 = animelem = 15
value = s20,1

[State 19, Gi Flop]
type = PlaySnd
triggerall = anim = 730
trigger1 = animelem = 17
value = s20,1

[State 19, Gi Flop]
type = PlaySnd
triggerall = anim = 3170
trigger1 = animelem = 10
value = s20,1

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim != 2 && Anim != 3 && Anim != 4
trigger1 = Anim != [25,100]
trigger1 = Anim != [200,3500]
trigger1 = Anim != [5300,5301]
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
trigger3 = Anim = [25,3500]
trigger3 = Animtime = 0
trigger4 = Anim = 5301
trigger4 = Animtime = 0
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 2]
type = Changeanim
trigger1 = random <= 200
trigger1 = Anim = 0 && Animelem = 15
value = 2

[State 0, 2]
type = Changeanim
trigger1 = Anim = 0 && Animtime = 0
value = 4

[State 0, 2]
type = Changeanim
trigger1 = random <= 500
trigger1 = Anim = 4 && Animelem = 16
value = 3

[State 0, 2]
type = Changeanim
trigger1 = Anim = 3 && Animtime = 0
value = 0
elem = 5

[State 0, 2]
type = Changeanim
trigger1 = Anim = 2 && Animtime = 0
value = 0
elem = 2

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch
[Statedef 11]
type    = C
physics = C
anim = 11
velset = 0,0
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 210, 1]
type = PlaySnd
trigger1 = animelem = 4
value = 20,0

[State 19, Gi Flop]
type = PlaySnd
trigger1 = animelem = 4
value = s20,1

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, dust]
type = helper
trigger1 = !animtime
helpertype = normal
stateno = 7100
ID = 7100
name = "Dust"
postype = p1
ownpal = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 0, VarSet]
type = VarSet
trigger1 = time =0
v = 13
value = 0

[State 0, VarSet]
type = VarSet
trigger1 = command = "superjump"
v = 13
value = 3

[State 40, 4]
type = VarSet
triggerall = Time = 0
trigger1 = (PrevStateNo = 100 || PrevStateNo = 110) && sysvar(1) = 1
trigger2 = Command = "superjump"
trigger3 = Command = "superjump" && Command = "holdfwd"
trigger4 = Command = "superjump" && Command = "holdback"
var(13) = 3

[State 0, VarSet]
type = VarSet
trigger1 = var(13)!=3
trigger1 = command != "holdup"
v = 13
value = 1;.75;(.75*1.15)

[State 0, VarSet]
type = VarSet
trigger1 = var(13)!=3
trigger1 = command = "holdup"
v = 13
value = 2

[State 0, VarSet]
type = VarSet
trigger1 = var(13)!=3
trigger1 = command = "holdup"
trigger1 = prevstateno = 100
v = 13
value = 4

[State 40, 4]
type = VelSet
trigger1 = var(13) = 1
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = (const(velocity.jump.y))*.75

[State 40, 4]
type = VelSet
trigger1 = (var(13) = 2) || (var(13) = 4)
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = (const(velocity.jump.y))

[State 40, 4]
type = VelSet
trigger1 = var(13) = 3
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = (const(velocity.jump.y))*1.15

[State 40, 5]
type = VelSet
trigger1 = var(13) = 1
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = (const(velocity.jump.y))*.75

[State 40, 5]
type = VelSet
trigger1 = (var(13) = 2) || (var(13) = 4)
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = (const(velocity.jump.y))

[State 40, 5]
type = VelSet
trigger1 = var(13) = 3
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = (const(velocity.jump.y))*1.15

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimTime = 0
trigger1 = (var(13) !=3) && (var(13) !=4)
value = S21,1
volume = 0
channel = -1

[State 0, PlaySnd]
type = PlaySnd
triggerall = AnimTime = 0
trigger1 = (var(13) =3) || (var(13) =4)
value = S21,2
volume = 0
channel = -1

[State 40, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

