;---------------------------------------
;^^^^^^ stage finishers^^^^^^
;---------------------------------------

;-------------------------------------------------------------
;^^^^^^^ ELECTR0's IM Code ^^^^^^^^
;-------------------------------------------------------------
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;--------------------------------------------------------------------------
; Gethit Sounds
[State -3,PlaySnd]
type = PlaySnd
triggerall = var(39) = 0
triggerall = Time = 1 && Alive && Random <= 500
triggerall = StateNo = 5000 || StateNo = 5010   || StateNo = 5035 || StateNo = 5070
trigger1 = Anim = 5000 || Anim = 5001 || Anim = 5002 || Anim = 5010 || Anim = 5011 || Anim = 5012 || Anim = 5020 || Anim = 5021 || Anim = 5022 || Anim = 5035 || Anim = 5070
value = s5000,0 + (random%8)

[State -3,PlaySnd]
type = PlaySnd
triggerall = var(39) = 1
triggerall = Time = 1 && Alive && Random <= 500
triggerall = StateNo = 5000 || StateNo = 5010   || StateNo = 5035 || StateNo = 5070
trigger1 = Anim = 5000 || Anim = 5001 || Anim = 5002 || Anim = 5010 || Anim = 5011 || Anim = 5012 || Anim = 5020 || Anim = 5021 || Anim = 5022 || Anim = 5035 || Anim = 5070
value = s5010,0 + (random%8)

;--------------------------------------------------------------------------
; Reset Skin Color
[State -3, RemapPal]
type = RemapPal
triggerall = var(49) = 1
trigger1 = RoundState = 0
source = 1,1
dest = 1,palno

;--------------------------------------------------------------------------
; Drop Sound
[State -3, Playsnd]
type = PlaySnd
triggerall = Time = 1
trigger1 = StateNo = 5100 || StateNo = 5110
value = 100, 5
channel = 20

[State -3, Airrecover]
type = hitfallset
trigger1 = stateno = 5050 && hitfall
value = 0

;--------------------------------------------------------------------------
; Cheap KO
[State -3, Cheap KO]
type = ChangeState
trigger1 = !Alive && (StateNo = [5000,5010])
trigger1 = (PrevStateNo = [130,131]) || (PrevStateNo = [140,141]) || (PrevStateNo = [150,153])
value = 5130
ignoreHitPause = 1

[State -3, Assert: NoKOsnd (Cheap KO)]
type = AssertSpecial
trigger1 = (StateNo = [5000,5010])
trigger1 = (PrevStateNo = [130,131]) || (PrevStateNo = [140,141]) || (PrevStateNo=[150,153])
flag = NoKOsnd
ignoreHitPause = 1

;--------------------------------------------------------------------------
; Custom Combo Chain
[State -3, Chain Reset]
type = varset
trigger1 = 1
var(21) = 0
ignorehitpause = 1

[State -3, Chain Check]
type = varset
trigger1 = var(20) && (stateno=[200,699]) && movecontact
trigger2 = var(20) && (stateno=[1000,1999]) && movecontact ;&& statetype!=A && (movecontact || var(18))
trigger3 = var(20) && (stateno=[1000,2999]) && (numhelper(1090))
;trigger3 = var(20) && (stateno=[1000,3999]) && (numhelper(1090))
;trigger3 = numhelper(1000) && (helper(1000),var(3))
;trigger3 = var(20) && stateno=1000 && animelemtime(6)>=0
;trigger4 = var(20) && stateno=1230 && animelemtime(12)>=0
;trigger5 = var(20) && stateno=1250 && animelemtime(9)>=0
var(21) = 1
ignorehitpause = 1

;--------------------------------------------------------------------------
; Super Jump Afterimage
[State -3, AfterImage]
type = afterimage
triggerall = time = 1
trigger1 = stateno = 50 && ((var(13) = 3) || (var(13) = 4))
time = 2
timegap = 1
framegap = 4
length = 9
palbright = 0,0,0
palcontrast = 128,128,128
palpostbright= 0,0,0
paladd = 0,0,0
palmul = .9,.9,.9
trans = add1

;--------------------------------------------------------------------------
; EX Flash
[State -3, ExFlash]
type = palfx
trigger1 = !(GameTime % 2) && stateno = [2000,2999]
time = 1
color = 0
mul = 256, 224, 0
add = 128, 128, 128
ignorehitpause = 1
persistent = 1

;--------------------------------------------------------------------------
; Super Level 1 Afterimage
[State -3, AfterImage]
type = Afterimage
triggerall = time= 45
trigger1 = stateno = 3001
trigger2 = stateno = [3101,3106]
trigger3 = stateno = 3350
timegap = 3
framegap = 6
length = 12
paladd = 0,0,0
palmul = .75,.75,.75
palcontrast=128,128,128
palpostbright = 0,0,0
persistent = 0
trans = add1

